    {
      "parameters": {
        "promptType": "define",
        "text": "=Create a concise and coherent report of approximately five sentences based on the provided sentiment-analysis summary data. \nThe data reflects how well the sentiment of user review texts aligns with the star ratings given by users. \n“Total” represents the number of analyzed reviews, “matches” shows how many review texts correspond to the given star rating, and “notMatches” indicates the number of mismatches. \n“Rate” expresses the percentage of reviews in which the sentiment correctly matches the assigned star rating. \nWrite the report in complete sentences and provide a short, human-readable interpretation of the results.\n\nMatches: {{ $json.matches }}\nNot matches: {{ $json.notMatches }}\nTotal: {{ $json.total }}\nMatch rate: {{ $json.rate }}%",
        "hasOutputParser": true,
        "batching": {}
