    {
      "parameters": {
        "jsCode": "let i = 0\n\nfor (const item of $input.all()) {\n  if (item.json.review_score >= 4 && item.json.sentimentAnalysis.category == \"Positive\" || \n     item.json.review_score == 3 && item.json.sentimentAnalysis.category == \"Neutral\" || item.json.review_score <= 2 && item.json.sentimentAnalysis.category == \"Negative\") {\n    item.json.matches = true\n    i = i+1\n  } else {\n    item.json.matches = false\n  }\n}\n\nconst total = $input.all().length;\nconst notMatching = total - i;\nconst rate = 100 - notMatching/total;\n\nreturn [\n  {\n    json: {\n      matches: i,\n      notMatches: notMatching,\n      total: total,\n      rate: rate,\n      data: $input.all()\n    }\n  }\n];"
      },
